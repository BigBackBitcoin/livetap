# LIVETAP web — environment variables
# Copy to .env.local for local development. NEVER commit real values.

# Mock mode is the default. Set to "false" only on a deployment that has real platform credentials.
LIVETAP_MOCK_MODE=true

# --- OAuth token broker (server-side only; used by api/oauth/*) ---
# YouTube (Google Cloud → OAuth client type "Web application"; redirect URI https://<your-domain>/oauth/callback)
LIVETAP_YOUTUBE_CLIENT_ID=
LIVETAP_YOUTUBE_CLIENT_SECRET=
# Twitch (dev.twitch.tv console; redirect URI https://<your-domain>/oauth/callback)
LIVETAP_TWITCH_CLIENT_ID=
LIVETAP_TWITCH_CLIENT_SECRET=
# Kick (developer portal; PKCE + client secret at token endpoint)
LIVETAP_KICK_CLIENT_ID=
LIVETAP_KICK_CLIENT_SECRET=
# Facebook (Live Video API requires App Review + Business Verification)
LIVETAP_FACEBOOK_APP_ID=
LIVETAP_FACEBOOK_APP_SECRET=

# --- Browser-visible (VITE_ prefix = public) ---
# Self-hosted relay for browser publishing (see infra/relay). Leave empty to disable web go-live.
VITE_LIVETAP_RELAY_URL=
