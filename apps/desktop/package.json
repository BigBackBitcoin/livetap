{
  "name": "@livetap/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LIVETAP desktop app (Electron) for macOS and Windows",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "tsup",
    "build:renderer": "npm run build -w @livetap/web -- --base ./ --outDir ../desktop/dist/renderer",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev": "npm run build:main && electron . --dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@livetap/core": "0.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.8"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "tsup": "^8.5.0"
  }
}
