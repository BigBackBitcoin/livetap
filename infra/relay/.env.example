# LIVETAP CORE relay — environment
#
#   cp .env.example .env
#
# .env holds live credentials. It must never be committed. Verify that
# infra/relay/.env is covered by .gitignore before you fill this in.

# ---------------------------------------------------------------------------
# Secrets (all three are required — compose refuses to start without them)
# ---------------------------------------------------------------------------

# Publisher credential.
# Two jobs: the Bearer token the web app sends to session-api, AND the password
# the browser uses for the WHIP publish. Anyone holding it can publish to a
# session that already exists — but NOT create one with their own destinations,
# and not read the Control API.
# Generate:  openssl rand -base64 32
MTX_PUBLISH_PASSWORD=

# MediaMTX Control API credential, used only by session-api.
# Deliberately different from the publisher password: it can rewrite path
# configuration and read every session's stream keys.
# Generate:  openssl rand -base64 32
MTX_API_PASSWORD=

# Credential the transcode hook uses to read the stream back over loopback
# RTSP inside the container. Never leaves the container.
# Generate:  openssl rand -base64 32
MTX_HOOK_PASSWORD=

# ---------------------------------------------------------------------------
# Reachability
# ---------------------------------------------------------------------------

# The hostname or IP that BROWSERS use to reach this relay. It is advertised as
# a WebRTC ICE candidate and baked into the whipUrl handed to the web app.
#
# Getting this wrong is the single most common cause of "WHIP connects then
# times out": the browser completes signalling over TCP but has no reachable
# UDP candidate. Use the public DNS name in production, not a bridge address.
#   local dev : 127.0.0.1
#   production: relay.yourdomain.com
LIVETAP_RELAY_PUBLIC_HOST=127.0.0.1

# Port and scheme the browser should use for WHIP.
# Behind the Caddy example in README.md these become 443 and https.
LIVETAP_RELAY_PUBLIC_WHIP_PORT=18889
LIVETAP_RELAY_PUBLIC_WHIP_SCHEME=http

# ---------------------------------------------------------------------------
# Optional behaviour
# ---------------------------------------------------------------------------

# Allow 9:16 destinations (TikTok, Reels, Shorts).
# When 0, a 9:16 destination is REFUSED with a clear message rather than
# silently sent a 16:9 frame. Turning it on adds a full crop+scale+x264
# re-encode: measured ~30% of one CPU core per session at 1080x1920, versus
# ~12-15% for the audio-only path. Budget accordingly.
LIVETAP_ENABLE_VERTICAL_TRANSCODE=0

# Audio bitrate for the mandatory Opus -> AAC transcode.
LIVETAP_RELAY_AUDIO_BITRATE=128k

# Video bitrate for the 9:16 re-encode (ignored unless enabled above).
LIVETAP_RELAY_VERTICAL_BITRATE=3000k
