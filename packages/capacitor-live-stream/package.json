{
  "name": "@livetap/capacitor-live-stream",
  "version": "0.1.0",
  "type": "module",
  "description": "LIVETAP native RTMP/RTMPS live-streaming Capacitor plugin for iOS (HaishinKit) and Android (RootEncoder)",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "android/src/main/",
    "android/build.gradle",
    "ios/Sources/",
    "Package.swift",
    "LivetapCapacitorLiveStream.podspec"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["capacitor", "plugin", "native", "rtmp", "livestream", "livetap"],
  "dependencies": {
    "@livetap/core": "0.1.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^7.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "sideEffects": false
}
